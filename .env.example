# Copy to .env (never commit .env). Local development only.
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Leave blank to use a NEW local SQLite database under instance/.
DATABASE_URL=
PUBLIC_BASE_URL=http://127.0.0.1:5000

# Optional: required only for Google sign-in.
CLIENT_ID=
CLIENT_SECRET=
# Optional: required for new-product AI analysis and writing enrichment.
OPENAI_API_KEY=
SECRET_API_KEY=
PRODUCTS_API_KEY=
# Optional: use Stripe test-mode credentials locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: email integration (not needed to browse or run tests).
G_EMAIL=
G_PASSWORD=
